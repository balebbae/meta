DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
SUPERTOKENS_CONNECTION_URI=https://st-dev-xxx.aws.supertokens.io
SUPERTOKENS_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
MODEL_API_KEY=
# Optional self-hosted fine-tuned Muse Glimmer for Rally move proof (OpenAI-compatible base URL, e.g. https://xyz.trycloudflare.com/v1).
# Unset = Ember only. On timeout/error/bad JSON the check falls back to Ember.
GLIMMER_PROOF_URL=
GLIMMER_PROOF_KEY=
GLIMMER_PROOF_MODEL=exercise_check
GLIMMER_PROOF_TIMEOUT_MS=6000
# WHOOP dashboard redirect URL must be <NEXT_PUBLIC_APP_URL>/api/whoop/callback
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Strava webhook handshake secret (required to register the webhook; pick any random string)
STRAVA_VERIFY_TOKEN=
# TURN relay so voice and video calls work off the same Wi-Fi. Public in the browser.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
